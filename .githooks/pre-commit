#!/bin/bash
# ============================================================
# Pre-commit Secret Scanner
# Blocks commits containing API keys, tokens, or credentials
# Community standard: detect-secrets / git-secrets / gitleaks
# ============================================================

echo "[pre-commit] Scanning for secrets..."

# Patterns that match common API key formats
PATTERNS=(
  'sk-[a-zA-Z0-9]{32,}'
  'sk-[a-zA-Z0-9]{48,}'
  'Bearer [a-zA-Z0-9._-]{20,}'
  'api_key\s*=\s*["'"'"'][a-zA-Z0-9._-]{20,}["'"'"']'
  'api[Kk]ey\s*=\s*["'"'"'][a-zA-Z0-9._-]{20,}["'"'"']'
  '-----BEGIN (RSA |EC |OPENSSH |DSA )?PRIVATE KEY-----'
  'github_pat_[a-zA-Z0-9_]{20,}'
  'ghp_[a-zA-Z0-9]{30,}'
)

# Files to skip
SKIP_PATTERNS='\.git/|node_modules/|venv/|\.venv/|__pycache__/|\.pyc$|\.lock$|package-lock\.json|yarn\.lock|\.min\.(css|js)$'

FOUND=0
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -z "$STAGED_FILES" ]; then
  exit 0
fi

for pattern in "${PATTERNS[@]}"; do
  while IFS= read -r file; do
    [ -z "$file" ] && continue
    # Skip binary and excluded files
    echo "$file" | grep -qE "$SKIP_PATTERNS" && continue
    if [ ! -f "$file" ]; then continue; fi

    # Search the staged version of the file
    MATCH=$(git diff --cached -- "$file" | grep -nE "$pattern" 2>/dev/null | head -5)
    if [ -n "$MATCH" ]; then
      if [ $FOUND -eq 0 ]; then
        echo ""
        echo "=========================================="
        echo "  SECURITY BLOCK: Secrets detected in commit"
        echo "=========================================="
        echo ""
      fi
      echo "  [$file]"
      echo "$MATCH" | while IFS= read -r line; do
        # Mask the secret value for display
        MASKED=$(echo "$line" | sed -E 's/(sk-[a-zA-Z0-9]{4})[a-zA-Z0-9]+/\1****/g' | sed -E 's/(Bearer )[a-zA-Z0-9._-]{4}[a-zA-Z0-9._-]+/\1****/g')
        echo "    $MASKED"
      done
      echo ""
      FOUND=1
    fi
  done <<< "$STAGED_FILES"
done

if [ $FOUND -eq 1 ]; then
  echo "  Commit blocked. Remove the secrets and try again."
  echo "  If this is a false positive, use: git commit --no-verify"
  echo "=========================================="
  exit 1
fi

# Also run detect-secrets if installed
if command -v detect-secrets &>/dev/null; then
  detect-secrets-hook --baseline .secrets.baseline 2>/dev/null || true
fi

echo "[pre-commit] Clean — no secrets found"
exit 0
