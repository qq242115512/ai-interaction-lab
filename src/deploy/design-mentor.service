[Unit]
Description=设计引路人 API Service
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/design-mentor
ExecStart=/opt/design-mentor/venv/bin/uvicorn main:app --host 127.0.0.1 --port 8080
Restart=always
RestartSec=5
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
